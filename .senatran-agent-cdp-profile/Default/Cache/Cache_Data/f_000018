<style>
  .hidden-error {
      display: none;
  }
  .br-message.error {
    margin-bottom: 1em;
    background: #fde0db;
    border: 1px solid #f86;
    max-width: 1440px !important;
    width: 100%;
  }
  .br-message p {
    margin-top: 1em;
    margin-bottom: 1em;
  }
  .br-message .icon {
    margin: 1.3em 0 0 0;
  }
  .br-message.error .icon i {
    color: #e52207
  }
  
  .login-offline-two-factor {
    margin: 3em 8em;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    align-content: stretch;
  }
  
  .login-offline-two-factor .mfa-recovery-section {
    display: flex; 
    flex-direction: row;
    gap: 0.5rem;
  }
  .login-offline-two-factor .mfa-recovery-link-loading {
     text-decoration: none;
     display: none;
     position: relative;
     top: 0.1em;
     width: fit-content;
     height: fit-content;
  }
  .login-offline-two-factor .mfa-recovery-loading-active {
     display: block;
     font-weight: bold;
     opacity: 0.6 !important;
     cursor: not-allowed !important;
     animation: spin 1.3s infinite linear;
  }
  
  .login-offline-two-factor .main-container {
    display: flex;
    align-items: flex-start; 
    gap: 1rem;
    max-width: 1440px !important;
  }
  
  .login-offline-two-factor .main-container main {
    display: flex; 
    flex-direction: column;
    
  }
  .login-offline-two-factor .main-container section {
    margin-bottom: 1.5em;
  }
  .login-offline-two-factor .main-container main > h1 {
    font-size: 2em;
    letter-spacing: 0.02em;
    color: #1351b4;
    margin-bottom: 1.5em;
    max-width: 530px;
  }
  
  .login-offline-two-factor .disclaimer {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }
  
  .login-offline-two-factor .disclaimer > input {
    min-width: 200px;
    max-width: 300px;
    border: 1px solid #000 !important;
    border-radius: 8px !important;
    padding: 1em !important;
    box-shadow: 0px 1px 5px rgba(0, 0, 0, 0.05), 0px 2px 4px rgba(0, 0, 0, 0.2) !important;
  }
  
  .login-offline-two-factor .disclaimer p{
    font-size: 1rem;
  }
  .login-offline-two-factor .disclaimer a {
  	color: #1351b4; 
  	font-size: 1rem; 
  	font-weight: 600;
  	text-decoration: underline;
  }
  
  .login-offline-two-factor .disclaimer .button-link {
    border: none;
    background: none;
    box-shadow: none;
    padding: 0;
    font-weight: 600;
    font-size: 1rem;
    color: #1351b4;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-align: left;
  }
  
  .login-offline-two-factor .disclaimer .remember-device {
    display: flex;
    align-items: center;
    margin-top: 2.5em;
  }
  
  .login-offline-two-factor .disclaimer .remember-device label{
    width: fit-content;
    cursor: pointer;
  }
  
  .login-offline-two-factor .disclaimer .remember-device .gdd-checkbox-input-default {
  	height: 1.5em;
	width: 1.5em;
	margin: 3px 15px 3px 4px !important;
	cursor: pointer;
  }
  
  .login-offline-two-factor .actions {
    margin: 0.5em 0 6.5em 0 !important;
    display: flex;
    gap: 1rem;
  }
  
  .login-offline-two-factor .main-container main .instructions {
    padding: 1em;
    max-width: 700px;
  }
  
  .login-offline-two-factor .main-container main .instructions h1 {
    font-weight: 600;
    font-size: 1.2em;
    color: rgba(19, 81, 180, 1);
    letter-spacing: 0.02em;
    margin: 0 !important;
  }
  .login-offline-two-factor .main-container main .instructions hr {
    margin: 0.5em 0;
  }
  
  .login-offline-two-factor .main-container main .instructions li {
    margin-top: 1em;
    font-weight: bold;
  }
  
  .login-offline-two-factor .main-container main .instructions .ready {
    margin-top: 1em;
    font-weight: bold;
  }
  
  .login-offline-two-factor .main-container main .instructions .instructions-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5em;
  }
  
  .login-offline-two-factor .main-container main .instructions .content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease-out;
    position: relative;
  }
  
  .login-offline-two-factor .main-container main .instructions .collapsible {
	cursor: pointer;
	width: 100%;
	outline: none;
  }
  
  .login-offline-two-factor .main-container main .instructions .instructions-warning {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 1rem;
	margin-top: 1rem;
  }
  
  .login-offline-two-factor .main-container main .instructions .instructions-warning > p {
    padding: 1rem;
    background-color: rgba(255, 245, 194, 1)
	  
  }
  
  .login-offline-two-factor .main-container main .generate-code-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    font-weight: bold;
  }
  .login-offline-two-factor .main-container main .generate-code-mobile > div{
    text-align: center;
    font-weight: 400;
    margin: 0 1rem;
  }
  .login-offline-two-factor .main-container main .generate-code-mobile > p{
    text-align: center;
    margin: 0 1rem;
  }
  
  .login-offline-two-factor .main-container main .instructions h1,
  .login-offline-two-factor .main-container main .instructions ol {
    list-style-position: inside;
    padding-left: 0;
    margin: 0;
  }
  
  .login-offline-two-factor .main-container main .instructions ol li::marker {
    font-weight: 700;
  }
  .login-offline-two-factor .main-container aside {
    flex: initial;
    text-align: center;
    padding: 2em;
  }
  .login-offline-two-factor .main-container aside .qrcode-instructions-desktop {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .login-offline-two-factor .main-container aside .qrcode-instructions-mobile {
    display: none;
  }
  .login-offline-two-factor .main-container aside section > p {
    margin-bottom: 1em;
  }
  
  .login-offline-two-factor .actions .button-ok:disabled {
    opacity: 0.6 !important;
    cursor: not-allowed !important;
    color: transparent !important;
    position: relative;
  }
  .login-offline-two-factor .actions .button-ok:disabled::after {
    animation: spin 1.3s infinite linear;
    border: 2px solid white;
    border-radius: 50%;
    border-right-color: transparent;
    content: "";
    display: block;
    height: 1.2em;
    left: calc(50% - 0.6em);
    position: absolute;
    top: calc(50% - 0.6em);
    width: 1.2em;
  }
  
  .login-offline-two-factor .actions .button-ok,
  .login-offline-two-factor .actions .button-cancel {
    min-width: 220px;
  }
  
  
  /* modal */
  
  .modal-content {
    min-width: 40em;
    font-size: 1em;
  }
  .modal-content p{
    font-size: 1em;
  }
  .modal-hint-recover2fa h1{
    font-size: 1.4em;
    color: #1351b4;
    letter-spacing: 0.02em;
  }
  
  .modal-hint-recover2fa h2{
    font-size: 1.1em;
    margin-top: 1em;
  }
  
  .modal-actions {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 1rem;
    margin: 2em 0;
  }
  .modal-content button{
    min-width: 220px;
  }
  
  /* resolutions */  
  
  @media (min-width: 2560px) {
    .login-offline-two-factor {
      margin: 3em 15em;
    }
  }
  
  @media (max-width: 1400px) {
    img {
     max-height: 600px;
    }
  }
  
  @media (max-width: 1200px) {
    .login-offline-two-factor {
      margin: 2rem 3rem;
    }
    img {
     max-height: 480px;
    }
  }
  
  @media (max-width: 975px) {
    .login-offline-two-factor {
      margin: 1rem 2rem;
      min-width: 800px;
    }
    .login-offline-two-factor .main-container {
      min-width: 400px;
    }
    .login-offline-two-factor .main-container main {
      min-width: 400px;
    }
    img {
     max-width: 310px;
    }
  }
  
  @media (max-width: 768px) {
    .br-message.error {
      margin: 1rem 0 1rem 0;
    }
    
    .login-offline-two-factor {
      margin: 1rem 2rem;
      min-width: 300px;
    }
    .login-offline-two-factor .main-container {
      min-width: 300px;
    }
    .login-offline-two-factor .mfa-recovery-section {
      flex-direction: column;
	  gap: 0.25rem;
	}
    .login-offline-two-factor .main-container main {
      min-width: auto;
    }
    .login-offline-two-factor .main-container main > h1 {
      font-size: 1.4rem;
    }
    .login-offline-two-factor .disclaimer > input {
      width: 100%;
      max-width: none;
      margin: 0.5em 0;
    }
    
    .login-offline-two-factor .main-container main .instructions {
      max-width: 100%;
      min-width: 0;
    }
    .login-offline-two-factor .disclaimer .remember-device {
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    
    .login-offline-two-factor .main-container {
      flex-direction: column;
    }
    .login-offline-two-factor .actions  {
      flex-direction: column-reverse;
      align-items: center;
      width: 100%;
      gap: 1.25rem;
      margin: 0 0 2rem 0 !important;
    }
    .login-offline-two-factor .actions button {
      width: 100%;
    }
    
    img {
      max-width: 100%;
    }
    
    
    
    
    /* @media modal */
    .modal-actions {
      flex-direction: column-reverse;
    }
    .modal-content {
      min-width: 0;
      width: 90%;
      font-size: 1rem;
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal-content p{
      font-size: 1rem;
    }
    .modal-content button{
      width: 100%;
    }
  }
  
</style>


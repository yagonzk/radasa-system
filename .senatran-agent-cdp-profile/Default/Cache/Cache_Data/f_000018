    focusOnLoad('otpInput');

    function onOtpSubmit(event) {
    	var otp = document.getElementById('otpInput').value;

    	var emptyOtp = !otp || otp.trim().length === 0;  
        var nonNumericOtp = /\D/.test(otp);
        var invalidLengthOtp = otp.trim().length != 6;

        if(!emptyOtp && !nonNumericOtp && !invalidLengthOtp) {
        	document.getElementById("enter-offline-2fa-code").disabled = true;
        	submitOperationForm('twoFactorForm', 'enter-offline-2fa-code');
            return;
        }
    	
        document.getElementById("front-error-panel").classList.remove("hidden-error");
        document.getElementById("front-error-panel").classList.add("br-message");
        document.getElementById("front-error-panel").classList.add("error");
        document.getElementById("backend-error-panel")?.classList.add("hidden-error");
        event.preventDefault();

        if (emptyOtp) {
            document.getElementById("front-error-message").innerHTML = "O código deve ser informado.";
            return;
    	}
        if (invalidLengthOtp) {
            document.getElementById("front-error-message").innerHTML = "O código deve conter 6 dígitos.";
            return;
        }
        if (nonNumericOtp) {
            document.getElementById("front-error-message").innerHTML = "O código deve conter apenas números.";
            return;
        } 
    }

    document.addEventListener("DOMContentLoaded", () => {
        const checkbox = document.getElementById("device");

        // Detecta o sistema operacional pelo user agent
        const userAgent = navigator.userAgent || navigator.vendor || window.opera;
        if (/android/i.test(userAgent)) {
            checkbox.classList.remove("gdd-checkbox-input-default");
            checkbox.classList.add("gdd-checkbox-input-android"); // Aplica a classe '.gdd-checkbox-input-android' para dispositivos Android
        } else if (/iPad|iPhone|iPod/.test(userAgent)) {
            checkbox.classList.remove("gdd-checkbox-input-default");
            checkbox.classList.add("gdd-checkbox-input-ios"); // Aplica a classe '.gdd-checkbox-input-ios' para dispositivos iOS
        }
    });

    var coll = document.getElementsByClassName("collapsible");
    var i;

    for (i = 0; i < coll.length; i++) {
      coll[i].addEventListener("click", function() {
        this.classList.toggle("active");
        var content = this.nextElementSibling;
        if (content.style.maxHeight){
          content.style.maxHeight = null;
          document.getElementById("instructions-chevron-id").classList.remove("fa-chevron-up");
          document.getElementById("instructions-chevron-id").classList.add("fa-chevron-down");
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
          document.getElementById("instructions-chevron-id").classList.remove("fa-chevron-down");
          document.getElementById("instructions-chevron-id").classList.add("fa-chevron-up");
        } 
      });
    }

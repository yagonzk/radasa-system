generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  BORRACHARIA
  MANUTENCAO
  VISUALIZACAO
  USER
}

enum TipoManifesto {
  BONIFICACAO_LEBRINHA
  ACERTAR_LEBRINHA
  RECEBER_CLIENTE
  VASILHAME
}

enum StatusMotorista {
  ATIVO
  FERIAS
  DEMITIDO
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
}

enum StatusCiot {
  RASCUNHO
  PRONTO_ENVIO
  PROCESSANDO
  AUTORIZADO
  REJEITADO
  CANCELADO
  ENCERRADO
}

enum TipoOperacaoCiot {
  LOTACAO
  FRACIONADA
  TAC_AGREGADO
}

enum SubcategoriaVeiculo {
  CAMINHAO
  CARRO
  MOTO
}


enum StatusDemanda {
  BACKLOG
  A_FAZER
  EM_ANDAMENTO
  AGUARDANDO
  CONCLUIDA
}

enum PrioridadeDemanda {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoDespesaViagem {
  PEDAGIO
  DIARIA
  CHAPA
  MANUTENCAO
  ESTACIONAMENTO
  ALIMENTACAO
  OUTROS
}


model Demanda {
  id          String            @id @default(cuid())
  titulo      String
  descricao   String            @default("") @db.Text
  status      StatusDemanda     @default(A_FAZER)
  prioridade  PrioridadeDemanda @default(MEDIA)
  responsavel String            @default("")
  etiquetas   String[]          @default([])
  dataPrazo   DateTime?         @db.Date
  ordem       Int               @default(0)
  arquivada   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, ordem])
  @@index([dataPrazo])
  @@index([arquivada])
  @@map("demandas")
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String     @unique
  email        String     @unique
  telefone     String     @default("")
  cpf          String?    @unique
  fotoPerfil   String?    @db.Text
  passwordHash String
  role         UserRole   @default(VISUALIZACAO)
  active       Boolean    @default(true)
  motoristaId  String?
  permissoes   Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Motorista {
  id                       String          @id @default(cuid())
  nome                     String
  cpf                      String
  rg                       String          @default("")
  dataNascimento           DateTime?       @db.Date
  telefone                 String          @default("")
  email                    String          @default("")
  endereco                 String          @default("")
  cidade                   String          @default("")
  uf                       String          @default("")
  cep                      String          @default("")
  salarioBase              Decimal         @db.Decimal(14, 2)
  dataAdmissao             DateTime?       @db.Date
  cnhNumero                String          @default("")
  cnhRegistro              String          @default("")
  cnhCategoria             String          @default("")
  cnhValidade              DateTime?       @db.Date
  cnhEmissao               DateTime?       @db.Date
  primeiraHabilitacao      DateTime?       @db.Date
  moppValidade             DateTime?       @db.Date
  toxicologicoValidade     DateTime?       @db.Date
  cnhPdfNome               String          @default("")
  cnhPdfUrl                String          @default("") @db.Text
  toxicologicoPdfNome      String          @default("")
  toxicologicoPdfUrl       String          @default("") @db.Text
  observacoes              String          @default("") @db.Text
  status                   StatusMotorista @default(ATIVO)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  viagens                  Viagem[]
  fechamentos              Fechamento[]
  ciots                    Ciot[]
  veiculos                 Veiculo[]
  multas                   Multa[]

  @@index([nome])
  @@index([cpf])
  @@index([cnhValidade])
  @@map("motoristas")
}

model Chapa {
  id        String   @id @default(cuid())
  nome      String
  telefone  String   @default("")
  cpf       String   @default("")
  cidade    String   @default("")
  chavePix  String   @default("")
  valorFixo Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nome])
  @@index([cpf])
  @@map("chapas")
}

model Cliente {
  id             String          @id @default(cuid())
  nomeFantasia   String
  razaoSocial    String          @default("")
  codigoInterno  String
  cnpj           String          @default("")
  email          String
  telefone       String
  enderecoFiscal String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  manifestos     Manifesto[]
  manifestoProdutos ManifestoProduto[]
  abastecimentos Abastecimento[]
  ciots          Ciot[]
  precosFiscais  FiscalPrecoProduto[]

  @@index([nomeFantasia])
  @@index([codigoInterno])
  @@index([cnpj])
  @@map("clientes")
}

model Fornecedor {
  id             String   @id @default(cuid())
  razaoSocial    String
  nomeFantasia   String   @default("")
  documento      String   @default("")
  tipos          String[] @default([])
  telefone       String   @default("")
  email          String   @default("")
  endereco       String   @default("")
  cidade         String   @default("")
  uf             String   @default("")
  contato        String   @default("")
  observacoes    String   @default("") @db.Text
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ordensServico  OrdemServico[]
  notasEstoque    EstoqueNotaFiscal[]

  @@index([razaoSocial])
  @@index([nomeFantasia])
  @@index([documento])
  @@index([ativo])
  @@map("fornecedores")
}

model Produto {
  id                   String                 @id @default(cuid())
  nome                 String
  codigoInterno        String
  categoriaEstoque     String                 @default("Produtos de piscina")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  manifestos           ManifestoProduto[]
  abastecimentos       AbastecimentoProduto[]
  precosFiscais        FiscalPrecoProduto[]

  @@index([nome])
  @@index([codigoInterno])
  @@map("produtos")
}


model FiscalPrecoProduto {
  id                    String   @id @default(cuid())
  produtoId             String
  clienteId             String?
  vigenciaInicio        DateTime @db.Date
  custoUnitarioLebrinha Decimal  @db.Decimal(14, 4)
  vendaUnitarioCliente  Decimal  @db.Decimal(14, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  produto               Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  cliente               Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@index([clienteId])
  @@index([vigenciaInicio])
  @@index([produtoId, clienteId, vigenciaInicio])
  @@map("fiscal_precos_produtos")
}


model EstoqueProduto {
  id             String                 @id @default(cuid())
  nome           String
  codigoInterno  String
  categoria      String                 @default("Produtos de Piscina")
  subcategoria   String                 @default("")
  ncm            String                 @default("")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  movimentacoes  EstoqueMovimentacao[]
  ordensServicoItens OrdemServicoItem[]

  @@index([nome])
  @@index([codigoInterno])
  @@index([categoria])
  @@map("estoque_produtos")
}

model EstoqueNotaFiscal {
  id            String               @id @default(cuid())
  chave         String               @unique
  numero        String               @default("")
  serie         String               @default("")
  dataEmissao   DateTime             @db.Date
  fornecedorId  String?
  xmlUrl        String?              @db.Text
  xmlName       String?
  pdfUrl        String?              @db.Text
  pdfName       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  fornecedor    Fornecedor?          @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  movimentacoes EstoqueMovimentacao[]

  @@index([fornecedorId])
  @@index([dataEmissao])
  @@map("estoque_notas_fiscais")
}

model EstoqueSubcategoria {
  id        String   @id @default(cuid())
  nome      String
  categoria String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoria, nome])
  @@index([categoria])
  @@map("estoque_subcategorias")
}

model EstoqueTipoProduto {
  id        String   @id @default(cuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nome])
  @@map("estoque_tipos_produto")
}

model Local {
  id            String             @id @default(cuid())
  cidade        String
  uf            String?            @db.VarChar(2)
  valorComissao Decimal            @db.Decimal(14, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  fechamentos   FechamentoViagem[]

  @@index([cidade])
  @@index([uf])
  @@map("locais")
}

model Veiculo {
  id                     String           @id @default(cuid())
  placa                  String
  modelo                 String?
  marca                  String           @default("")
  renavam                String           @default("")
  chassi                 String           @default("")
  anoFabricacao          Int?
  anoModelo              Int?
  cor                    String           @default("")
  combustivel            String           @default("")
  proprietario           String           @default("")
  situacaoOperacional    String           @default("DISPONIVEL")
  subcategoria           SubcategoriaVeiculo?
  motoristaId            String?
  quantidadePneus        Int              @default(10)
  quantidadeEstepes      Int              @default(1)
  crlvValidade           DateTime?        @db.Date
  ipvaVencimento         DateTime?        @db.Date
  ipvaPago               Boolean          @default(false)
  ipvaValor              Decimal          @default(0) @db.Decimal(14, 2)
  licenciamentoVencimento DateTime?       @db.Date
  licenciamentoValor     Decimal          @default(0) @db.Decimal(14, 2)
  seguroValidade         DateTime?        @db.Date
  seguroValor            Decimal          @default(0) @db.Decimal(14, 2)
  rntrc                  String           @default("")
  crlvPdfNome            String           @default("")
  crlvPdfUrl             String           @default("") @db.Text
  observacoes            String           @default("") @db.Text
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  abastecimentos         Abastecimento[]
  instalacoesPneus       PneuInstalacao[] @relation("VeiculoInstalacoes")
  instalacoesComoCarreta PneuInstalacao[] @relation("CarretaInstalacoes")
  rodiziosPneus          PneuRodizio[]    @relation("VeiculoRodizios")
  rodiziosComoCarreta    PneuRodizio[]    @relation("CarretaRodizios")
  ciots                  Ciot[]
  motorista              Motorista?       @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  multas                  Multa[]

  @@index([placa])
  @@index([renavam])
  @@index([subcategoria])
  @@index([motoristaId])
  @@index([crlvValidade])
  @@index([ipvaVencimento])
  @@map("veiculos")
}

model Multa {
  id             String    @id @default(cuid())
  veiculoId      String
  motoristaId    String?
  autoInfracao   String    @default("")
  codigoInfracao String    @default("")
  orgaoAutuador  String    @default("")
  dataInfracao   DateTime  @db.Date
  hora           String    @default("")
  local          String    @default("")
  descricao      String    @default("") @db.Text
  pontos         Int       @default(0)
  valorOriginal  Decimal   @default(0) @db.Decimal(14, 2)
  valorAtual     Decimal   @default(0) @db.Decimal(14, 2)
  vencimento     DateTime? @db.Date
  status         String    @default("PENDENTE")
  observacoes    String    @default("") @db.Text
  documentoUrl   String?   @db.Text
  documentoNome  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  veiculo        Veiculo   @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  motorista      Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)

  @@index([veiculoId])
  @@index([motoristaId])
  @@index([dataInfracao])
  @@index([vencimento])
  @@index([status])
  @@index([autoInfracao])
  @@map("multas")
}

model Viagem {
  id                 String    @id @default(cuid())
  codigo             String?   @unique
  status             String    @default("PLANEJADA")
  placa              String
  motoristaId        String
  clienteId          String?
  valorFrete         Decimal   @db.Decimal(14, 2)
  dataManifesto      DateTime  @db.Date
  cidadeOrigem       String    @default("")
  cidadeEntrega      String
  rotas              String[]  @default([])
  distanciaKm        Decimal   @db.Decimal(14, 2)
  kmSaida            Decimal?  @db.Decimal(14, 1)
  kmChegada          Decimal?  @db.Decimal(14, 1)
  dataSaida          DateTime?
  previsaoChegada    DateTime?
  dataChegada        DateTime?
  valorPedagio       Decimal   @db.Decimal(14, 2)
  valorDiaria        Decimal   @db.Decimal(14, 2)
  valorAbastecimento Decimal   @db.Decimal(14, 2)
  valorChapa         Decimal   @db.Decimal(14, 2)
  valorMulta         Decimal   @default(0) @db.Decimal(14, 2)
  custoExtraTag      String    @default("")
  valorCustoExtra    Decimal   @default(0) @db.Decimal(14, 2)
  observacoes        String    @default("") @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  motorista          Motorista @relation(fields: [motoristaId], references: [id], onDelete: Restrict)
  despesasExtrato    ViagemDespesaExtrato[]

  @@index([motoristaId])
  @@index([clienteId])
  @@index([placa])
  @@index([status])
  @@index([dataManifesto])
  @@map("viagens")
}

model Fechamento {
  id          String             @id @default(cuid())
  motoristaId String
  dataInicio  DateTime           @db.Date
  dataFim     DateTime           @db.Date
  valorTotal  Decimal            @db.Decimal(14, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  motorista   Motorista          @relation(fields: [motoristaId], references: [id], onDelete: Restrict)
  viagens     FechamentoViagem[]

  @@index([motoristaId])
  @@index([dataInicio, dataFim])
  @@map("fechamentos")
}

model FechamentoViagem {
  id           String     @id @default(cuid())
  fechamentoId String
  localId      String
  quantidade   Int
  dataViagem   DateTime?  @db.Date
  fechamento   Fechamento @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  local        Local      @relation(fields: [localId], references: [id], onDelete: Restrict)

  @@index([fechamentoId])
  @@index([localId])
  @@index([dataViagem])
  @@map("fechamento_viagens")
}

model Manifesto {
  id                    String             @id @default(cuid())
  clienteId             String
  dataManifesto         DateTime           @db.Date
  tipoManifesto         TipoManifesto
  pdfUrl                String?            @db.Text
  transportadoraCodigo  String             @default("")
  transportadoraNome    String             @default("")
  veiculoCodigo         String             @default("")
  placaVeiculo          String             @default("")
  modeloVeiculo         String             @default("")
  romaneios             String             @default("") @db.Text
  notasFiscais          String             @default("") @db.Text
  createdAt             DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cliente       Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  produtos      ManifestoProduto[]

  @@index([clienteId])
  @@index([dataManifesto])
  @@map("manifestos")
}

model ManifestoProduto {
  id            String         @id @default(cuid())
  manifestoId   String
  produtoId     String
  clienteId     String?
  romaneio      String         @default("")
  notaFiscal    String         @default("")
  serieNf       String         @default("")
  instrucaoCobranca String     @default("") @db.Text
  quantidade    Decimal        @db.Decimal(14, 3)
  valorUnitario Decimal        @db.Decimal(14, 2)
  valorTotal    Decimal        @db.Decimal(14, 2)
  tipoManifesto TipoManifesto?
  pagoCliente   Boolean?
  manifesto     Manifesto      @relation(fields: [manifestoId], references: [id], onDelete: Cascade)
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  cliente       Cliente?       @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([manifestoId])
  @@index([produtoId])
  @@index([clienteId])
  @@map("manifesto_produtos")
}

model Ciot {
  id                   String           @id @default(cuid())
  idSequencial         Int              @unique @default(autoincrement())
  clienteId            String?
  empresaId            String?
  contratanteRazaoSocial String          @default("")
  contratanteNomeFantasia String         @default("")
  contratanteCnpj       String           @default("")
  contratadoRazaoSocial String           @default("")
  contratadoNomeFantasia String          @default("")
  contratadoCnpj       String           @default("")
  contratadoInscricaoEstadual String     @default("")
  contratadoEndereco   String           @default("") @db.Text
  contratadoCidade     String           @default("")
  contratadoUf         String           @default("")
  motoristaId          String
  veiculoId            String
  tipoOperacao         TipoOperacaoCiot
  status               StatusCiot       @default(RASCUNHO)
  rntrc                String
  origemCidade         String
  origemUf             String
  destinoCidade        String
  destinoUf            String
  dataInicio           DateTime         @db.Date
  dataFim              DateTime?        @db.Date
  naturezaCarga        String
  pesoKg               Decimal          @default(0) @db.Decimal(14, 3)
  valorFrete           Decimal          @default(0) @db.Decimal(14, 2)
  valorPedagio         Decimal          @default(0) @db.Decimal(14, 2)
  outrosValores        Decimal          @default(0) @db.Decimal(14, 2)
  descontos            Decimal          @default(0) @db.Decimal(14, 2)
  valorLiquido         Decimal          @default(0) @db.Decimal(14, 2)
  formaPagamento       String           @default("")
  favorecidoPix        String           @default("")
  payloadAntt          Json?
  preparadoEm          DateTime?
  observacoes          String?          @db.Text
  numeroCiot           String?
  codigoVerificador    String?
  protocolo            String?
  mensagemRetorno      String?          @db.Text
  valorMercadoria      Decimal          @default(0) @db.Decimal(14, 2)
  cnpjsCargaFracionada String           @default("") @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  cliente              Cliente?         @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  empresa              Empresa?         @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  motorista            Motorista        @relation(fields: [motoristaId], references: [id], onDelete: Restrict)
  veiculo              Veiculo          @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  ctes                 CiotCte[]

  @@index([clienteId])
  @@index([empresaId])
  @@index([motoristaId])
  @@index([veiculoId])
  @@index([status])
  @@index([dataInicio])
  @@map("ciots")
}

model CiotCte {
  id               String   @id @default(cuid())
  ciotId           String
  chave            String
  numero           String
  serie            String   @default("")
  emitenteCnpj     String   @default("")
  emitenteNome     String   @default("")
  emitenteNomeFantasia String @default("")
  emitenteInscricaoEstadual String @default("")
  emitenteEndereco String @default("") @db.Text
  emitenteCidade   String @default("")
  emitenteUf       String @default("")
  remetenteCnpj    String   @default("")
  remetenteNome    String   @default("")
  destinatarioCnpj String   @default("")
  destinatarioNome String   @default("")
  tomadorCnpj      String   @default("")
  tomadorNome      String   @default("")
  origemCidade     String   @default("")
  origemUf         String   @default("")
  destinoCidade    String   @default("")
  destinoUf        String   @default("")
  produto          String   @default("")
  ncm              String   @default("")
  pesoKg           Decimal  @default(0) @db.Decimal(14, 3)
  valorMercadoria  Decimal  @default(0) @db.Decimal(14, 2)
  valorFrete       Decimal  @default(0) @db.Decimal(14, 2)
  valorPedagio      Decimal  @default(0) @db.Decimal(14, 2)
  xmlUrl           String?  @db.Text
  arquivoNome      String   @default("")
  dataEmissao      DateTime? @db.Date
  createdAt        DateTime @default(now())
  ciot             Ciot     @relation(fields: [ciotId], references: [id], onDelete: Cascade)

  @@unique([ciotId, chave])
  @@index([ciotId])
  @@index([chave])
  @@map("ciot_ctes")
}

model Abastecimento {
  id                        String                 @id @default(cuid())
  clienteId                 String
  veiculoId                 String
  chaveNfe                  String?                @unique
  numeroNfe                 String                 @default("")
  serieNfe                  String                 @default("")
  emitenteCnpj              String                 @default("")
  emitenteRazaoSocial       String                 @default("")
  emitenteNomeFantasia      String                 @default("")
  emitenteInscricaoEstadual String                 @default("")
  emitenteEndereco          String                 @default("") @db.Text
  emitenteCidade            String                 @default("")
  emitenteUf                String                 @default("")
  destinatarioCnpjCpf       String                 @default("")
  destinatarioRazaoSocial   String                 @default("")
  destinatarioEndereco      String                 @default("") @db.Text
  destinatarioCidade        String                 @default("")
  destinatarioUf            String                 @default("")
  naturezaOperacao          String                 @default("")
  placaXml                  String                 @default("")
  hodometroOrigem           String                 @default("") @db.Text
  valorProdutos             Decimal                @default(0) @db.Decimal(14, 2)
  valorFrete                Decimal                @default(0) @db.Decimal(14, 2)
  valorSeguro               Decimal                @default(0) @db.Decimal(14, 2)
  valorOutros               Decimal                @default(0) @db.Decimal(14, 2)
  valorIcms                 Decimal                @default(0) @db.Decimal(14, 2)
  valorPis                  Decimal                @default(0) @db.Decimal(14, 2)
  valorCofins               Decimal                @default(0) @db.Decimal(14, 2)
  informacoesComplementares String                 @default("") @db.Text
  dataEmissao               DateTime               @db.Date
  valorDesconto             Decimal                @default(0) @db.Decimal(14, 2)
  valorTotal                Decimal                @db.Decimal(14, 2)
  hodometro                 Decimal                @db.Decimal(14, 1)
  pdfUrl                    String?                @db.Text
  xmlUrl                    String?                @db.Text
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  cliente                   Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  veiculo                   Veiculo                @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  produtos                  AbastecimentoProduto[]

  @@index([clienteId])

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  BORRACHARIA
  MANUTENCAO
  VISUALIZACAO
  USER
}

enum TipoManifesto {
  BONIFICACAO_LEBRINHA
  ACERTAR_LEBRINHA
  RECEBER_CLIENTE
}

enum StatusMotorista {
  ATIVO
  DEMITIDO
}



enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(VISUALIZACAO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Motorista {
  id          String       @id @default(cuid())
  nome        String
  cpf         String
  salarioBase Decimal          @db.Decimal(14, 2)
  status      StatusMotorista @default(ATIVO)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime     @updatedAt
  viagens     Viagem[]
  fechamentos Fechamento[]

  @@index([nome])
  @@map("motoristas")
}

model Chapa {
  id        String   @id @default(cuid())
  nome      String
  valorFixo Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nome])
  @@map("chapas")
}

model Cliente {
  id             String      @id @default(cuid())
  nomeFantasia   String
  razaoSocial    String      @default("")
  codigoInterno  String
  cnpj            String      @default("")
  email           String
  telefone        String
  enderecoFiscal String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  manifestos      Manifesto[]
  abastecimentos Abastecimento[]

  @@index([nomeFantasia])
  @@index([codigoInterno])
  @@index([cnpj])
  @@map("clientes")
}

model Produto {
  id            String              @id @default(cuid())
  nome          String
  codigoInterno String
  categoriaEstoque String @default("Produtos de piscina")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  manifestos    ManifestoProduto[]
  abastecimentos AbastecimentoProduto[]
  movimentacoesEstoque EstoqueMovimentacao[]
  sefazItens SefazDocumentItem[]

  @@index([nome])
  @@index([codigoInterno])
  @@map("produtos")
}

model Local {
  id            String              @id @default(cuid())
  cidade        String
  valorComissao Decimal             @db.Decimal(14, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  fechamentos   FechamentoViagem[]

  @@index([cidade])
  @@map("locais")
}

model Veiculo {
  id        String   @id @default(cuid())
  placa              String
  modelo             String?
  quantidadePneus    Int      @default(10)
  quantidadeEstepes  Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt
  abastecimentos Abastecimento[]
  instalacoesPneus PneuInstalacao[] @relation("VeiculoInstalacoes")
  instalacoesComoCarreta PneuInstalacao[] @relation("CarretaInstalacoes")
  rodiziosPneus PneuRodizio[] @relation("VeiculoRodizios")
  rodiziosComoCarreta PneuRodizio[] @relation("CarretaRodizios")

  @@index([placa])
  @@map("veiculos")
}

model Viagem {
  id                 String     @id @default(cuid())
  placa              String
  motoristaId        String
  valorFrete         Decimal    @db.Decimal(14, 2)
  dataManifesto      DateTime   @db.Date
  cidadeEntrega      String
  distanciaKm        Decimal    @db.Decimal(14, 2)
  valorPedagio       Decimal    @db.Decimal(14, 2)
  valorDiaria        Decimal    @db.Decimal(14, 2)
  valorAbastecimento Decimal    @db.Decimal(14, 2)
  valorChapa         Decimal    @db.Decimal(14, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  motorista          Motorista @relation(fields: [motoristaId], references: [id], onDelete: Restrict)

  @@index([motoristaId])
  @@index([placa])
  @@index([dataManifesto])
  @@map("viagens")
}

model Fechamento {
  id           String              @id @default(cuid())
  motoristaId String
  dataInicio   DateTime            @db.Date
  dataFim      DateTime            @db.Date
  valorTotal   Decimal             @db.Decimal(14, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  motorista    Motorista           @relation(fields: [motoristaId], references: [id], onDelete: Restrict)
  viagens      FechamentoViagem[]

  @@index([motoristaId])
  @@index([dataInicio, dataFim])
  @@map("fechamentos")
}

model FechamentoViagem {
  id           String     @id @default(cuid())
  fechamentoId String
  localId      String
  quantidade   Int
  fechamento   Fechamento @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  local        Local      @relation(fields: [localId], references: [id], onDelete: Restrict)

  @@index([fechamentoId])
  @@index([localId])
  @@map("fechamento_viagens")
}

model Manifesto {
  id             String              @id @default(cuid())
  clienteId      String
  dataManifesto  DateTime            @db.Date
  tipoManifesto  TipoManifesto
  pdfUrl          String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  cliente         Cliente             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  produtos        ManifestoProduto[]

  @@index([clienteId])
  @@index([dataManifesto])
  @@map("manifestos")
}

model ManifestoProduto {
  id             String         @id @default(cuid())
  manifestoId    String
  produtoId      String
  quantidade     Decimal        @db.Decimal(14, 3)
  valorUnitario  Decimal        @db.Decimal(14, 2)
  valorTotal     Decimal        @db.Decimal(14, 2)
  tipoManifesto  TipoManifesto?
  manifesto      Manifesto      @relation(fields: [manifestoId], references: [id], onDelete: Cascade)
  produto        Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([manifestoId])
  @@index([produtoId])
  @@map("manifesto_produtos")
}



model Abastecimento {
  id               String                  @id @default(cuid())
  clienteId        String
  veiculoId        String
  dataEmissao      DateTime                @db.Date
  valorDesconto    Decimal                 @default(0) @db.Decimal(14, 2)
  valorTotal       Decimal                 @db.Decimal(14, 2)
  hodometro        Decimal                 @db.Decimal(14, 1)
  pdfUrl           String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  cliente          Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  veiculo          Veiculo                 @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  produtos         AbastecimentoProduto[]

  @@index([clienteId])
  @@index([veiculoId])
  @@index([dataEmissao])
  @@map("abastecimentos")
}

model AbastecimentoProduto {
  id                String          @id @default(cuid())
  abastecimentoId   String
  produtoId         String
  quantidadeLitros  Decimal         @db.Decimal(14, 3)
  valorUnitario     Decimal         @db.Decimal(14, 4)
  valorTotal        Decimal         @db.Decimal(14, 2)
  abastecimento     Abastecimento   @relation(fields: [abastecimentoId], references: [id], onDelete: Cascade)
  produto            Produto         @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([abastecimentoId])
  @@index([produtoId])
  @@map("abastecimento_produtos")
}


enum StatusPneu {
  ESTOQUE
  INSTALADO
  MANUTENCAO
  RECAPAGEM
  DESCARTADO
}

enum TipoPneu {
  DIRECIONAL
  TRACAO
  LIVRE
}

enum CondicaoPneu {
  NOVO
  USADO
  RECAPADO
  AGUARDANDO_RECAPAGEM
}

enum TipoEventoPneu {
  COMPRA
  ALTERACAO
  STATUS
  FOTO
  INSTALACAO
  RETIRADA
  RODIZIO
  SULCO
  CALIBRAGEM
  RECAPAGEM
  CONSERTO
  INSPECAO
}

model EstoqueMovimentacao {
  id            String                    @id @default(cuid())
  produtoId     String
  tipo          TipoMovimentacaoEstoque
  quantidade    Decimal                   @db.Decimal(14, 3)
  valorUnitario Decimal                   @default(0) @db.Decimal(14, 2)
  valorTotal    Decimal                   @default(0) @db.Decimal(14, 2)
  data          DateTime                  @db.Date
  observacoes   String?
  pdfUrl        String?                   @db.Text
  pdfName       String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  produto       Produto                   @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  sefazDocumentId String?
  sefazDocument SefazDocument? @relation(fields: [sefazDocumentId], references: [id], onDelete: SetNull)

  @@index([produtoId])
  @@index([tipo])
  @@index([data])
  @@index([sefazDocumentId])
  @@map("estoque_movimentacoes")
}

model Pneu {
  id                   String          @id @default(cuid())
  numeroFogo           String          @unique
  codigoBarras         String?
  qrCode               String?
  marca                String
  modelo               String
  medida               String
  dot                  String
  numeroSerie          String?
  tipo                  TipoPneu
  valorCompra           Decimal         @db.Decimal(14, 2)
  fornecedor           String
  dataCompra            DateTime        @db.Date
  maxRecapagens         Int             @default(0)
  recapagensRealizadas  Int             @default(0)
  status                StatusPneu      @default(ESTOQUE)
  condicao              CondicaoPneu    @default(NOVO)
  sulcoInicial          Decimal?        @db.Decimal(6, 2)
  sulcoAtual            Decimal?        @db.Decimal(6, 2)
  kmAtual               Decimal         @default(0) @db.Decimal(14, 1)
  proximoRodizioKm      Decimal?        @db.Decimal(14, 1)
  observacoes           String?         @db.Text
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  fotos                 PneuFoto[]
  eventos               PneuEvento[]
  instalacoes            PneuInstalacao[]
  rodizioMovimentos      PneuRodizioMovimento[]
  medicoesSulco          PneuMedicaoSulco[]
  calibragens            PneuCalibragem[]
  recapagens             PneuRecapagem[]
  consertos              PneuConserto[]
  inspecoes              PneuInspecao[]

  @@index([status])
  @@index([condicao])
  @@index([marca])
  @@index([dataCompra])
  @@map("pneus")
}

model PneuFoto {
  id        String   @id @default(cuid())
  pneuId    String
  url       String   @db.Text
  legenda   String?
  createdAt DateTime @default(now())
  pneu      Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId])
  @@map("pneu_fotos")
}

model PneuEvento {
  id          String         @id @default(cuid())
  pneuId      String
  tipo        TipoEventoPneu
  data        DateTime       @default(now())
  quilometragem Decimal?     @db.Decimal(14, 1)
  responsavel String?
  observacoes String?        @db.Text
  dados       Json?
  createdAt   DateTime       @default(now())
  pneu        Pneu           @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId])
  @@index([data])
  @@map("pneu_eventos")
}

model PneuInstalacao {
  id               String   @id @default(cuid())
  pneuId           String
  veiculoId        String
  carretaId        String?
  eixo             String
  posicao          String
  dataInstalacao   DateTime @db.Date
  kmInstalacao     Decimal  @db.Decimal(14, 1)
  responsavel      String
  dataRetirada     DateTime? @db.Date
  kmRetirada       Decimal? @db.Decimal(14, 1)
  motivoRetirada   String?  @db.Text
  statusDestino    StatusPneu?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  pneu             Pneu     @relation(fields: [pneuId], references: [id], onDelete: Restrict)
  veiculo          Veiculo  @relation("VeiculoInstalacoes", fields: [veiculoId], references: [id], onDelete: Restrict)
  carreta          Veiculo? @relation("CarretaInstalacoes", fields: [carretaId], references: [id], onDelete: Restrict)

  @@index([pneuId, ativo])
  @@index([veiculoId, ativo])
  @@index([carretaId, ativo])
  @@index([eixo, posicao])
  @@map("pneu_instalacoes")
}

model PneuRodizio {
  id            String   @id @default(cuid())
  veiculoId     String
  carretaId     String?
  data          DateTime @db.Date
  quilometragem Decimal  @db.Decimal(14, 1)
  responsavel   String
  motivo        String   @db.Text
  createdAt     DateTime @default(now())
  veiculo       Veiculo  @relation("VeiculoRodizios", fields: [veiculoId], references: [id], onDelete: Restrict)
  carreta       Veiculo? @relation("CarretaRodizios", fields: [carretaId], references: [id], onDelete: Restrict)
  movimentos    PneuRodizioMovimento[]

  @@index([veiculoId, data])
  @@index([carretaId, data])
  @@map("pneu_rodizios")
}

model PneuRodizioMovimento {
  id             String      @id @default(cuid())
  rodizioId      String
  pneuId         String
  eixoOrigem     String
  posicaoOrigem  String
  eixoDestino    String
  posicaoDestino String
  rodizio        PneuRodizio @relation(fields: [rodizioId], references: [id], onDelete: Cascade)
  pneu            Pneu        @relation(fields: [pneuId], references: [id], onDelete: Restrict)

  @@index([rodizioId])
  @@index([pneuId])
  @@map("pneu_rodizio_movimentos")
}


model PneuMedicaoSulco {
  id                 String   @id @default(cuid())
  pneuId             String
  data               DateTime @db.Date
  quilometragem      Decimal? @db.Decimal(14, 1)
  sulcoInterno       Decimal  @db.Decimal(6, 2)
  sulcoCentral       Decimal  @db.Decimal(6, 2)
  sulcoExterno       Decimal  @db.Decimal(6, 2)
  mediaSulco         Decimal  @db.Decimal(6, 2)
  percentualDesgaste Decimal  @db.Decimal(6, 2)
  vidaUtilRestante   Decimal  @db.Decimal(6, 2)
  responsavel        String
  observacoes        String?  @db.Text
  createdAt          DateTime @default(now())
  pneu               Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_medicoes_sulco")
}

model PneuCalibragem {
  id                 String   @id @default(cuid())
  pneuId             String
  data               DateTime @db.Date
  pressaoRecomendada Decimal  @db.Decimal(8, 2)
  pressaoEncontrada  Decimal  @db.Decimal(8, 2)
  pressaoAjustada    Decimal  @db.Decimal(8, 2)
  responsavel        String
  observacoes        String?  @db.Text
  createdAt          DateTime @default(now())
  pneu               Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_calibragens")
}

model PneuRecapagem {
  id               String   @id @default(cuid())
  pneuId           String
  empresaRecapadora String
  dataEnvio        DateTime @db.Date
  dataRetorno      DateTime? @db.Date
  valor            Decimal  @db.Decimal(14, 2)
  garantiaMeses    Int      @default(0)
  tipoRecapagem    String
  numeroRecapagem  Int
  observacoes      String?  @db.Text
  createdAt        DateTime @default(now())
  pneu             Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@unique([pneuId, numeroRecapagem])
  @@index([pneuId, dataEnvio])
  @@map("pneu_recapagens")
}

model PneuConserto {
  id            String   @id @default(cuid())
  pneuId        String
  tipo          String
  data          DateTime @db.Date
  valor         Decimal  @db.Decimal(14, 2)
  responsavel   String
  observacoes   String?  @db.Text
  fotosAntes    Json?
  fotosDepois   Json?
  createdAt     DateTime @default(now())
  pneu          Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_consertos")
}

model PneuInspecao {
  id                 String   @id @default(cuid())
  pneuId             String
  data               DateTime @db.Date
  responsavel        String
  pressaoOk          Boolean
  sulcoOk            Boolean
  cortes             Boolean  @default(false)
  bolhas              Boolean  @default(false)
  trincas             Boolean  @default(false)
  desgasteIrregular  Boolean  @default(false)
  lonaAparente        Boolean  @default(false)
  observacoes         String?  @db.Text
  fotos               Json?
  createdAt           DateTime @default(now())
  pneu                Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_inspecoes")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  method    String
  path      String
  entityId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum SefazSyncStatus {
  RUNNING
  SUCCESS
  EMPTY
  BLOCKED
  ERROR
}

model SefazCertificate {
  id                    String          @id @default(cuid())
  cnpj                   String          @unique
  fileName               String
  subject                String
  issuer                 String?
  serialNumber           String?
  validFrom              DateTime
  validTo                DateTime
  cnpjValidated          Boolean         @default(false)
  certificateEncrypted   Bytes
  certificateIv          String
  certificateTag         String
  passwordEncrypted      Bytes
  passwordIv             String
  passwordTag            String
  active                 Boolean         @default(true)
  lastNsu                String          @default("000000000000000")
  maxNsu                 String          @default("000000000000000")
  lastSyncAt             DateTime?
  nextSyncAllowedAt      DateTime?
  autoSyncEnabled        Boolean         @default(false)
  autoSyncIntervalMinutes Int            @default(60)
  lastAutoSyncAt         DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  documents              SefazDocument[]
  syncLogs               SefazSyncLog[]

  @@index([active])
  @@index([validTo])
  @@map("sefaz_certificates")
}

model SefazSyncLog {
  id              String          @id @default(cuid())
  certificateId   String
  status          SefazSyncStatus
  cStat           String?
  message         String?         @db.Text
  initialNsu      String
  lastNsu         String?
  maxNsu          String?
  documentsFound  Int             @default(0)
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  certificate     SefazCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId, startedAt])
  @@map("sefaz_sync_logs")
}

model SefazDocument {
  id                  String           @id @default(cuid())
  certificateId       String
  nsu                 String
  schema              String
  accessKey           String?
  documentType        String?
  issuerCnpj          String?
  issuerName          String?
  recipientCnpj       String?
  recipientName       String?
  emissionDate        DateTime?
  totalValue          Decimal?         @db.Decimal(18, 2)
  number              String?
  series              String?
  operationType       String?
  status              String?
  manifestationType   SefazManifestationType?
  manifestationStatus SefazManifestationStatus @default(NONE)
  manifestationProtocol String?
  manifestedAt        DateTime?
  importedAt          DateTime?
  isSummary           Boolean          @default(false)
  xmlEncrypted        Bytes
  xmlIv               String
  xmlTag              String
  receivedAt          DateTime         @default(now())
  certificate         SefazCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  items               SefazDocumentItem[]
  events              SefazDocumentEvent[]
  stockMovements      EstoqueMovimentacao[]

  @@unique([certificateId, nsu])
  @@index([certificateId, emissionDate])
  @@index([accessKey])
  @@map("sefaz_documents")
}

enum SefazManifestationType {
  CIENCIA
  CONFIRMACAO
  DESCONHECIMENTO
  NAO_REALIZADA
}

enum SefazManifestationStatus {
  NONE
  PROCESSING
  SUCCESS
  ERROR
}

model SefazDocumentItem {
  id              String        @id @default(cuid())
  documentId      String
  itemNumber      Int
  supplierCode    String?
  ean             String?
  description     String
  ncm             String?
  cfop            String?
  unit            String?
  quantity        Decimal       @db.Decimal(18, 4)
  unitValue       Decimal       @db.Decimal(18, 6)
  totalValue      Decimal       @db.Decimal(18, 2)
  matchedProdutoId String?
  document        SefazDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  matchedProduto  Produto?      @relation(fields: [matchedProdutoId], references: [id], onDelete: SetNull)

  @@unique([documentId, itemNumber])
  @@index([matchedProdutoId])
  @@map("sefaz_document_items")
}

model SefazDocumentEvent {
  id          String        @id @default(cuid())
  documentId  String
  type        String
  description String
  userId      String?
  protocol    String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  document    SefazDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("sefaz_document_events")
}


  createdAt DateTime @default(now())

  @@map("configuracoes_sistema")
}


model ViagemDespesaExtrato {
  id          String   @id @default(cuid())
  viagemId    String
  tipo        String
  data        DateTime @db.Date
  hora        String   @default("")
  valor       Decimal  @db.Decimal(14, 2)
  descricao   String   @default("") @db.Text
  colaborador String   @default("")
  origem      String   @default("TRUCKPAG")
  fingerprint String   @unique
  createdAt   DateTime @default(now())
  viagem      Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)

  @@index([viagemId])
  @@index([tipo])
  @@index([data])
  @@map("viagem_despesas_extrato")
}

model SefazSyncState {
  id          String   @id @default(cuid())
  empresaId   String   @unique
  ultNsu      String   @default("000000000000000")
  maxNsu      String   @default("000000000000000")
  lastCStat   String   @default("")
  lastMessage String   @default("") @db.Text
  lastQueryAt DateTime?
  forceRequestedAt DateTime?
  agentLastSeenAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empresaId])
  @@map("sefaz_sync_state")
}

model SefazDocumento {
  id                  String    @id @default(cuid())
  empresaId           String
  chave               String    @unique
  nsu                  String    @default("")
  schema               String    @default("")
  tipo                 String    @default("NFE")
  classificacao       String    @default("OUTRO")
  status               String    @default("NOVO")
  numero               String    @default("")
  serie                String    @default("")
  dataEmissao          DateTime? @db.Date
  emitenteCnpj         String    @default("")
  emitenteNome         String    @default("")
  valorTotal           Decimal   @default(0) @db.Decimal(14, 2)
  placa                String    @default("")
  hodometro            Decimal?  @db.Decimal(14, 1)
  xmlUrl               String?   @db.Text
  dados                 Json?
  erro                  String    @default("") @db.Text
  abastecimentoId      String?
  importedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([empresaId, nsu])
  @@index([empresaId])
  @@index([status])
  @@index([classificacao])
  @@index([dataEmissao])
  @@map("sefaz_documentos")
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radasa-system",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RadasaRealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime",
      "new_sqlite_classes": [
        "RadasaRealtimeHub"
      ]
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "AUTH_REQUIRED": "true",
    "CLIENT_ORIGIN": "https://radasa.com.br,https://www.radasa.com.br",
    "EMAIL_FROM_NAME": "Radasa System",
    "EMAIL_FROM_ADDRESS": "sistema@radasa.com.br",
    "RESEND_API_URL": "https://api.resend.com",
    "PASSWORD_RESET_BASE_URL": "https://radasa.com.br",
    "PASSWORD_RESET_TTL_MINUTES": "30",
    "ANTT_CIOT_ENVIRONMENT": "homologacao",
    "ANTT_CIOT_ENABLE_NETWORK": "true",
    "ANTT_CIOT_BASE_URL": "https://appservices-hml.antt.gov.br/pefServices"
  },
  "mtls_certificates": [
    {
      "binding": "ANTT_CIOT_MTLS",
      "certificate_id": "691b796f-5d40-4b8a-ace3-547b56fae535"
    }
  ]
}

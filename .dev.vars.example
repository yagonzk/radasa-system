# Use este arquivo apenas como modelo para `wrangler dev`.
# Copie para `.dev.vars` e NÃO faça commit do arquivo real.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
JWT_SECRET="troque-por-o-mesmo-jwt-secret-da-producao-com-32-ou-mais-caracteres"

# Cloudflare Email Service (binding EMAIL é configurado no wrangler.jsonc)
EMAIL_FROM_ADDRESS="sistema@radasa.com.br"
PASSWORD_RESET_BASE_URL="http://localhost:8787"
PASSWORD_RESET_TTL_MINUTES="30"

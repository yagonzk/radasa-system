# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radasa?schema=public"

# Servidor
NODE_ENV="development"
PORT="3001"
CLIENT_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"

# Autenticação
JWT_SECRET="troque-por-uma-chave-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="8h"
AUTH_REQUIRED="true"

# Recuperação de senha por e-mail (Resend)
# Em produção, configure RESEND_API_KEY com `pnpm exec wrangler secret put RESEND_API_KEY`.
RESEND_API_KEY="re_substitua_por_sua_chave"
RESEND_API_URL="https://api.resend.com"
EMAIL_FROM_NAME="Radasa System"
EMAIL_FROM_ADDRESS="sistema@radasa.com.br"
PASSWORD_RESET_BASE_URL="http://localhost:3000"
PASSWORD_RESET_TTL_MINUTES="30"

# Usuário administrativo inicial (usado por pnpm db:seed)
ADMIN_USERNAME=admin
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@radasa.local"
ADMIN_PASSWORD="troque-esta-senha"

# Pedágios: base própria do Radasa (sem token/API comercial)
